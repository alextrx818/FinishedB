{
  // Don't watch or index anything under venv/ or logs/
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/football/Formatter/venv/**": true,
    "**/logs/**": true
  },
  // Don't search inside venv/ or logs/
  "search.exclude": {
    "**/venv/**": true,
    "**/football/Formatter/venv/**": true,
    "**/logs/**": true
  },
  // Hide logs folder from file explorer
  "files.exclude": {
    "**/logs/**": true
  },
  // Python-specific settings
  "python.analysis.extraPaths": [
    "/root/CascadeProjects/sports_bot"
  ],
  // Exclude venv from linting
  "python.linting.ignorePatterns": [
    "**/venv/**"
  ],
  // Editor performance optimizations
  "editor.formatOnSave": false,
  // Disable auto-fetching type information for performance
  "python.analysis.indexing": false,
  // Telemetry settings
  "telemetry.telemetryLevel": "off"
}
